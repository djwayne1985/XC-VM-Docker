# XC_VM Docker defaults
# Edit these values before deploying to production.

# Install/update behavior
UPDATE_ON_START=false

# External MariaDB account created by entrypoint
MYSQL_REMOTE_USER=xcvm_admin
MYSQL_REMOTE_PASSWORD=ChangeMeNow123!

# Panel admin reset behavior at startup
PANEL_RESET_ON_START=true
PANEL_ADMIN_USERNAME=admin2026
PANEL_ADMIN_PASSWORD=AdminPass123!

# Container keepalive command
START_COMMAND=sleep infinity
